generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HR
  MANAGER
  TEAM_LEADER
  WORKER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ClockType {
  IN
  OUT
}

enum ClockMethod {
  AUTO
  MANUAL
}

enum GpsConfidence {
  HIGH
  MEDIUM
  LOW
  UNRELIABLE
}

enum LocationSource {
  GPS
  MANUAL
  OFFLINE_SYNC
}

enum LocationStatus {
  ONSITE
  OFFSITE
  UNKNOWN
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_REMOVED
  SHIFT_REMINDER
  SHIFT_OPEN
  SHIFT_DROPPED
  SHIFT_CLAIMED_YOU
  SHIFT_CLAIMED_OTHER
  MISSED_CLOCK_IN
  CLOCK_OUT_PROMPT
  GENERAL
}

enum TrainingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum DbsStatus {
  PENDING
  CLEAR
  FLAGGED
  EXPIRED
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftStatus {
  SCHEDULED
  OPEN
  CLAIMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftType {
  LONG_DAY
  MID_DAY
  WAKE_NIGHT
  SLEEP_IN
}

// Office Attendance Foundation V1 — discriminates a care rota (House-backed)
// shift from a future Location-backed work occurrence. Every existing shift and
// every shift the current code creates is ROTA (column default). FIXED /
// FLEXIBLE are foundation-only values: nothing creates, reads, or branches on
// them yet.
enum ShiftKind {
  ROTA
  FIXED
  FLEXIBLE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftChangeType {
  COVER
  SWAP
}

enum ShiftChangeStatus {
  PENDING_RECIPIENT // waiting for the target worker to accept / decline
  PENDING_MANAGER // target accepted, waiting for manager / HR approval
  APPROVED // manager approved, assignment(s) changed
  REJECTED // target declined OR manager rejected
  CANCELLED // requester withdrew it before approval
  EXPIRED // a shift involved started before it could be actioned
}

enum ShiftChangeRecipientResponse {
  ACCEPTED
  DECLINED
}

// ─── Whole-Workforce Phase 1: employment structure ────────────────────────
// These enums describe EMPLOYMENT, not authorization. The Role enum
// (WORKER/TEAM_LEADER/MANAGER/HR) is the only authorization concept and is
// unchanged.

enum LocationType {
  CARE_SERVICE
  SUPPORTED_LIVING
  RESIDENTIAL_HOME
  OFFICE
  MAINTENANCE_BASE
  OTHER
}

enum WorkPatternType {
  ROTA // rota-based shifts (the existing behaviour; default for every user)
  FIXED // repeating fixed hours (office). No behaviour attached in Phase 1.
  FLEXIBLE // no fixed pattern. No behaviour attached in Phase 1.
}

enum EmploymentType {
  PERMANENT
  BANK
  CONTRACTOR
}

enum AccrualMethod {
  FLAT_RATE // fixed hours awarded per completed pay period
  HOURLY // hours earned as a fraction of actual hours worked
  LUMP_SUM // full annual allowance granted upfront
}

enum PayPeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum LeaveLedgerType {
  ACCRUAL // periodic / worked-hours / lump-sum accrual
  CARRY_OVER // hours rolled in from the previous cycle (after the carry-over cap)
  ADJUSTMENT // manual correction by an admin
  RESET // year-end zeroing of accrued hours
}

model Agency {
  id         String   @id @default(cuid())
  name       String
  clerkOrgId String?  @unique
  // IANA timezone that defines this agency's operational "day" for the
  // dashboard, rota, attendance, payroll and reporting. Never the server's
  // (UTC on Railway) or the browser's timezone. See src/lib/agencyTime.js.
  timezone   String   @default("Europe/London")
  // Maximum scheduled hours any one worker may be rostered in an agency week
  // (Mon 00:00 -> next Mon 00:00 in `timezone`). Assignments above this need an
  // explicit manager/HR override with a reason. Service logic reads this value
  // — never a hardcoded number. See src/services/staffAllocationService.js.
  maxWeeklyScheduledHours Int @default(60)
  // Whole-Workforce: employee IDs are auto-generated as `${employeeIdPrefix}-0001`.
  // The prefix is HR-configurable (uppercase, 2–8 alphanumerics). The counter is
  // reserved with a single atomic increment per hire and only ever moves
  // forward — a number left unused by a failed invite just leaves a gap; a
  // reused number is never acceptable. Not derived from `name` (names change).
  employeeIdPrefix     String?
  employeeIdNextNumber Int     @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users                User[]
  houses               House[]
  shifts               Shift[]
  clockEvents          ClockEvent[]
  attendanceMonitors   AttendanceMonitor[]
  timesheets           Timesheet[]
  notifications        Notification[]
  trainings            Training[]
  dbsChecks            DbsCheck[]
  shareCodes           ShareCode[]
  auditLogs            AuditLog[]
  leaveRequests        LeaveRequest[]
  supportedPeople      SupportedPerson[]
  announcements        Announcement[]
  leaveAccrualProfiles LeaveAccrualProfile[]
  leaveBalances        LeaveBalance[]
  leaveLedgerEntries   LeaveLedgerEntry[]
  shiftChangeRequests  ShiftChangeRequest[]
  departments          Department[]
  jobTitles            JobTitle[]
  locations            Location[]
  pendingEmployees     PendingEmployee[]
}

model User {
  id                 String     @id @default(cuid())
  agencyId           String
  clerkUserId        String?    @unique
  name               String
  email              String     @unique
  passwordHash       String?
  role               Role
  status             UserStatus @default(ACTIVE)
  phone              String?
  bio                String?
  profilePicture     String?
  address            String?
  fcmToken           String?
  contractedHours    Float?
  onboardedAt        DateTime?
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // ── Whole-Workforce Phase 1: employment information (all nullable / defaulted;
  //    additive — no existing behaviour depends on any of these). ──
  employeeNumber    String?
  departmentId      String?
  jobTitleId        String?
  primaryLocationId String?
  lineManagerId     String?
  workPatternType   WorkPatternType @default(ROTA)
  employmentType    EmploymentType?

  // ── HR Onboarding V1 (all nullable, additive). Employment start date is the
  //    HR-meaningful hire date (distinct from createdAt = row creation).
  //    Emergency contact is the employee's own — NOT SupportedPerson's. ──
  employmentStartDate          DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  managedHouses         House[]              @relation("ManagerHouses")
  workerHouses          HouseWorker[]
  teamLeaderHouses      HouseTeamLeader[]
  createdShifts         Shift[]              @relation("ShiftCreator")
  workerShifts          Shift[]              @relation("ShiftWorker")
  cancelledShifts       Shift[]              @relation("ShiftCanceller")
  shiftClaims           ShiftClaim[]
  clockEvents           ClockEvent[]
  attendanceMonitors    AttendanceMonitor[]
  timesheets            Timesheet[]          @relation("WorkerTimesheets")
  confirmedTimesheets   Timesheet[]          @relation("ConfirmedTimesheets")
  reviewedTimesheets    Timesheet[]          @relation("ReviewedTimesheets")
  notifications         Notification[]
  trainings             Training[]
  dbsCheck              DbsCheck?
  shareCode             ShareCode?           @relation("UserShareCode")
  updatedShareCodes     ShareCode[]          @relation("ShareCodeUpdater")
  deactivatedBy         User?                @relation("UserDeactivations", fields: [deactivatedById], references: [id])
  deactivatedUsers      User[]               @relation("UserDeactivations")
  createdLeaveRequests  LeaveRequest[]       @relation("LeaveRequestCreator")
  approvedLeaveRequests LeaveRequest[]       @relation("LeaveRequestReviewer")
  announcements         Announcement[]       @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  leaveAccrualProfile   LeaveAccrualProfile?
  leaveBalance          LeaveBalance?
  leaveLedgerEntries    LeaveLedgerEntry[]
  shiftChangesRequested ShiftChangeRequest[] @relation("ShiftChangeRequester")
  shiftChangesTargeted  ShiftChangeRequest[] @relation("ShiftChangeTarget")
  shiftChangesManaged   ShiftChangeRequest[] @relation("ShiftChangeManager")
  department            Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle             JobTitle?            @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  primaryLocation      Location?            @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  lineManager          User?                @relation("UserLineManager", fields: [lineManagerId], references: [id])
  directReports        User[]               @relation("UserLineManager")

  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, employeeNumber])
  @@index([agencyId])
  @@index([status])
  @@index([deactivatedById])
  @@index([agencyId, departmentId])
  @@index([agencyId, jobTitleId])
  @@index([agencyId, primaryLocationId])
  @@index([lineManagerId])
}

model House {
  id             String   @id @default(cuid())
  agencyId       String   @default("default-agency")
  name           String
  address        String
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(50)
  autoConfirm    Boolean  @default(false)
  managerId      String?
  assignedHours  Float?
  // Whole-Workforce Phase 1: every House is now backed by a Location row (1:1,
  // set by the backfill migration). The House's OWN latitude/longitude/
  // geofenceRadius remain AUTHORITATIVE for care clock-in in Phase 1 — nothing
  // in clockService reads Location yet. This is a link for the directory /
  // reporting only.
  locationId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager            User?               @relation("ManagerHouses", fields: [managerId], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workers            HouseWorker[]
  teamLeaders        HouseTeamLeader[]
  shifts             Shift[]
  clockEvents        ClockEvent[]
  attendanceMonitors AttendanceMonitor[]
  timesheets         Timesheet[]
  supportedPeople    SupportedPerson[]

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([locationId])
}

model SupportedPerson {
  id                    String    @id @default(cuid())
  agencyId              String
  houseId               String
  name                  String
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  house  House  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([houseId])
}

model HouseWorker {
  houseId  String
  workerId String

  house  House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  worker User  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([houseId, workerId])
  @@index([workerId]) // "which houses is this worker in" — PK leads with houseId
}

model HouseTeamLeader {
  houseId      String
  teamLeaderId String

  house      House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  teamLeader User  @relation(fields: [teamLeaderId], references: [id], onDelete: Cascade)

  @@id([houseId, teamLeaderId])
  @@index([teamLeaderId]) // rota/allocation "which house does this TL run"
}

model Shift {
  id                 String      @id @default(cuid())
  agencyId           String      @default("default-agency")
  // Location-Backed Shift V1: a Shift now targets EXACTLY ONE attendance
  // target — houseId (ROTA) or locationId (FIXED) — enforced at the
  // application layer by shiftService.assertShiftAttendanceTarget, never by a
  // DB constraint. Every existing/ROTA shift keeps houseId set and locationId
  // null; child attendance records (ClockEvent/AttendanceMonitor/Timesheet)
  // still require houseId and are therefore only ever written for House-backed
  // shifts in this phase.
  houseId            String?
  locationId         String?
  workerId           String?
  createdById        String
  startTime          DateTime
  endTime            DateTime
  date               DateTime
  shiftType          ShiftType   @default(LONG_DAY)
  kind               ShiftKind   @default(ROTA)
  status             ShiftStatus @default(SCHEDULED)
  eligibleRoles      String[]    @default([])
  urgent             Boolean     @default(false)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime    @default(now())

  // onDelete: Restrict preserves the exact FK behaviour houseId always had
  // (ON DELETE RESTRICT) now that the column is optional — Prisma's implicit
  // default for an optional relation is SetNull, which would silently change
  // the constraint. This migration is DROP NOT NULL only.
  house             House?             @relation(fields: [houseId], references: [id], onDelete: Restrict)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  worker            User?              @relation("ShiftWorker", fields: [workerId], references: [id])
  createdBy         User               @relation("ShiftCreator", fields: [createdById], references: [id])
  cancelledBy       User?              @relation("ShiftCanceller", fields: [cancelledById], references: [id])
  clockEvents       ClockEvent[]
  timesheet         Timesheet?
  claims            ShiftClaim[]
  attendanceMonitor AttendanceMonitor?
  shiftChangesPrimary ShiftChangeRequest[] @relation("ShiftChangePrimary")
  shiftChangesSwap    ShiftChangeRequest[] @relation("ShiftChangeSwap")
  agency            Agency             @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([agencyId, startTime, endTime])
  @@index([workerId, startTime, endTime])
  // Cross-agency time-window scan used by missedClockInJob every 5 minutes
  // (WHERE startTime BETWEEN ? AND ?), which no agency-scoped index can serve.
  @@index([startTime])
  // Foundation: future Location-scoped shift lookups (unused today).
  @@index([agencyId, locationId])
}

model ShiftClaim {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id])
  claimedAt DateTime @default(now())
  status    String   @default("CLAIMED") // for future: PENDING|ACCEPTED|REJECTED
  createdAt DateTime @default(now())

  @@unique([shiftId, workerId])
  @@index([workerId])
  @@index([shiftId])
}

model ClockEvent {
  id             String          @id @default(cuid())
  agencyId       String          @default("default-agency")
  workerId       String
  houseId        String
  shiftId        String
  type           ClockType
  method         ClockMethod
  timestamp      DateTime        @default(now())
  accuracy       Float?
  gpsConfidence  GpsConfidence?
  locationSource LocationSource?

  // Attendance evidence — captured once per discrete clock event, never a
  // continuous breadcrumb trail. Distance is always computed on the server.
  capturedAt            DateTime?
  latitude              Float?
  longitude             Float?
  distanceMeters        Float?
  geofenceRadius        Int?
  withinGeofence        Boolean?
  locationStatusResult  LocationStatus?
  verification          String?
  mockLocationSuspected Boolean         @default(false)

  // Office Attendance Foundation field only — always NULL today. Care clock
  // events keep writing `houseId` exactly as before; nothing reads this yet.
  locationId String?

  worker   User      @relation(fields: [workerId], references: [id])
  house    House     @relation(fields: [houseId], references: [id])
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shift    Shift     @relation(fields: [shiftId], references: [id])
  agency   Agency    @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([shiftId, type])
  @@index([locationId])
}

// Live attendance-monitoring state for one clocked-in shift. Created on clock-in,
// closed on clock-out. Holds only the CURRENT reading + debounce/grace state so
// the shift-aware GPS lifecycle and the auto-clock-out grace machine have a
// single source of truth — it is not a movement history.
model AttendanceMonitor {
  id                         String         @id @default(cuid())
  agencyId                   String         @default("default-agency")
  shiftId                    String         @unique
  workerId                   String
  houseId                    String
  locationStatus             LocationStatus @default(UNKNOWN)
  lastLatitude               Float?
  lastLongitude              Float?
  lastAccuracy               Float?
  lastDistanceMeters         Float?
  lastReadingAt              DateTime?
  consecutiveOutsideCount    Int            @default(0)
  geofenceExitConfirmedAt    DateTime?
  stillWorkingConfirmedAt    DateTime?
  exitPromptSnoozedUntil     DateTime?
  shiftEndPromptedAt         DateTime?
  shiftEndAckAt              DateTime?
  autoClockOutGraceStartedAt DateTime?
  autoClockOutReminderSentAt DateTime?
  flaggedForReviewAt         DateTime?
  closedAt                   DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  // Office Attendance Foundation field only — always NULL today. Care monitors
  // keep writing `houseId` exactly as before; nothing reads this yet.
  locationId String?

  shift    Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  worker   User      @relation(fields: [workerId], references: [id])
  house    House     @relation(fields: [houseId], references: [id])
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  agency   Agency    @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([closedAt])
  @@index([locationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  agencyId   String   @default("default-agency")
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  agency     Agency   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Timesheet {
  id              String          @id @default(cuid())
  agencyId        String          @default("default-agency")
  workerId        String
  houseId         String
  shiftId         String          @unique
  clockInAt       DateTime?
  clockOutAt      DateTime?
  totalHours      Float?
  status          TimesheetStatus @default(PENDING)
  rejectionReason String?

  // Attendance outcome, for payroll / manager review.
  clockInLocationStatus  LocationStatus?
  clockOutLocationStatus LocationStatus?
  clockOutMethod         ClockMethod?
  needsReview            Boolean         @default(false)
  reviewReason           String?
  confirmedById          String?
  confirmedAt            DateTime?
  reviewedById           String?
  reviewedAt             DateTime?
  autoConfirmed          Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Office Attendance Foundation field only — always NULL today. Care timesheets
  // keep writing `houseId` exactly as before; nothing reads this yet.
  locationId String?

  worker      User      @relation("WorkerTimesheets", fields: [workerId], references: [id])
  house       House     @relation(fields: [houseId], references: [id])
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shift       Shift     @relation(fields: [shiftId], references: [id])
  confirmedBy User?     @relation("ConfirmedTimesheets", fields: [confirmedById], references: [id])
  reviewedBy  User?     @relation("ReviewedTimesheets", fields: [reviewedById], references: [id])
  agency      Agency    @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([agencyId, workerId]) // GET /timesheets/me
  @@index([agencyId, houseId]) // GET /timesheets/house/:id + PDF export
  @@index([agencyId, status]) // dashboard pending-timesheet list + count
  @@index([agencyId, needsReview]) // dashboard "needs review" list (rare -> true)
  @@index([locationId])
}

model Notification {
  id        String           @id @default(cuid())
  agencyId  String           @default("default-agency")
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  // Replaces the bare [agencyId] index. Every authenticated page load hits the
  // unread-count query (agencyId + userId + read=false); GET /notifications
  // reuses the agencyId+userId prefix then sorts its <=50 rows by createdAt.
  @@index([agencyId, userId, read])
  // Idempotency dedup lookups in the announcement fan-out and missed-clock-in
  // job (userId + type + a JSON-path match done in memory).
  @@index([userId, type])
}

model Training {
  id          String         @id @default(cuid())
  agencyId    String         @default("default-agency")
  userId      String
  title       String
  description String?
  status      TrainingStatus @default(PENDING)
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([agencyId, userId]) // GET /training/me + /training/user/:id
}

model DbsCheck {
  id        String    @id @default(cuid())
  agencyId  String    @default("default-agency")
  userId    String    @unique
  status    DbsStatus @default(PENDING)
  reference String?
  issuedAt  DateTime?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

/// UK Right-to-Work share code + proof document. "Stale" (needs re-submitting) is
/// derived, not stored: no record, or `shareDate` older than 90 days.
model ShareCode {
  id           String   @id @default(cuid())
  agencyId     String   @default("default-agency")
  userId       String   @unique
  code         String
  shareDate    DateTime
  documentPath String?
  documentName String?
  notes        String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User   @relation("UserShareCode", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("ShareCodeUpdater", fields: [updatedById], references: [id])
  agency    Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model LeaveRequest {
  id              String             @id @default(cuid())
  agencyId        String             @default("default-agency")
  workerId        String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Hours this request consumes from the worker's balance. Derived from the
  // date range at creation (weekdays x daily contracted hours) so the PTO
  // engine can reason in hours regardless of how the range was picked.
  totalHours Float @default(0)

  worker     User   @relation("LeaveRequestCreator", fields: [workerId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])
  agency     Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([workerId])
  @@index([status])
  @@index([startDate, endDate])
  // checkLeaveConflict runs on every shift create/update/claim:
  // WHERE agencyId=? AND workerId=? AND status='APPROVED' AND date-overlap.
  @@index([agencyId, workerId, status])
}

/// Per-user PTO accrual policy. One row per user; HR/managers configure it.
model LeaveAccrualProfile {
  id                   String        @id @default(cuid())
  agencyId             String
  userId               String        @unique
  method               AccrualMethod @default(FLAT_RATE)
  payPeriod            PayPeriod     @default(MONTHLY) // cadence for FLAT_RATE
  flatRateHours        Float         @default(0) // hours per completed pay period
  hourlyAccrualRate    Float         @default(0) // leave hours earned per hour worked
  lumpSumHours         Float         @default(0) // annual hours granted upfront
  accrualStartDate     DateTime      @default(now())
  balanceCeilingHours  Float? // hard cap on Gross Available (null = uncapped)
  carryOverCapHours    Float? // max hours that roll to next cycle (null = uncapped)
  allowNegativeBalance Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

/// Materialised balance state for the current accrual cycle.
model LeaveBalance {
  id               String   @id @default(cuid())
  agencyId         String
  userId           String   @unique
  cycleStartDate   DateTime // start of the current accrual year
  carriedOverHours Float    @default(0) // brought in from the previous cycle (post-cap)
  accruedHours     Float    @default(0) // cached accrual-to-date snapshot (authoritative for LUMP_SUM)
  lastAccrualAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

/// Append-only history of accrual events (accruals, carry-over, adjustments, resets).
model LeaveLedgerEntry {
  id          String          @id @default(cuid())
  agencyId    String
  userId      String
  type        LeaveLedgerType
  hours       Float // signed: + adds to accrued, - removes
  description String?
  effectiveAt DateTime        @default(now())
  createdAt   DateTime        @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  agencyId  String
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  agency Agency             @relation(fields: [agencyId], references: [id])
  reads  AnnouncementRead[]

  @@index([agencyId])
  @@index([createdAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

/// Worker-initiated Shift Cover / Shift Swap request. One shared model for both:
///  - COVER: requester gives `primaryShift` to `targetWorker` (swapShift null)
///  - SWAP : requester's `primaryShift` <-> targetWorker's `swapShift`
/// Creating or accepting a request NEVER changes a shift's workerId — only a
/// MANAGER/HR approval does, inside a single transaction, after re-validating
/// against current data.
model ShiftChangeRequest {
  id       String            @id @default(cuid())
  agencyId String
  type     ShiftChangeType
  status   ShiftChangeStatus @default(PENDING_RECIPIENT)

  requesterId    String
  primaryShiftId String
  targetWorkerId String?
  swapShiftId    String? // only set for type = SWAP

  requesterReason String?

  recipientRespondedAt DateTime?
  recipientResponse    ShiftChangeRecipientResponse?

  managerId         String?
  managerDecisionAt  DateTime?
  managerReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency       Agency @relation(fields: [agencyId], references: [id])
  requester    User   @relation("ShiftChangeRequester", fields: [requesterId], references: [id])
  targetWorker User?  @relation("ShiftChangeTarget", fields: [targetWorkerId], references: [id])
  manager      User?  @relation("ShiftChangeManager", fields: [managerId], references: [id])
  primaryShift Shift  @relation("ShiftChangePrimary", fields: [primaryShiftId], references: [id])
  swapShift    Shift? @relation("ShiftChangeSwap", fields: [swapShiftId], references: [id])

  @@index([agencyId, status])
  @@index([requesterId, status])
  @@index([targetWorkerId, status])
  @@index([primaryShiftId])
  @@index([swapShiftId])
}

// ─── Whole-Workforce Phase 1: Organisation structure ─────────────────────────
// Department / JobTitle / Location describe how a company is organised. They are
// tenant-scoped, company-editable, and carry NO authorization meaning. Prefer
// `active = false` (deactivation) over hard delete for referenced records.

model Department {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency     @relation(fields: [agencyId], references: [id])
  users     User[]
  jobTitles JobTitle[]

  @@unique([agencyId, name])
  @@index([agencyId, active])
}

model JobTitle {
  id           String   @id @default(cuid())
  agencyId     String
  name         String
  // Suggested default department for people with this title. A SUGGESTION only —
  // HR may put a user with this title in a different department. Never an
  // authorization constraint.
  departmentId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency     Agency      @relation(fields: [agencyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users      User[]

  @@unique([agencyId, name])
  @@index([agencyId, active])
}

model Location {
  id             String       @id @default(cuid())
  agencyId       String
  name           String
  type           LocationType
  address        String?
  latitude       Float?
  longitude      Float?
  // Phase 1: NOT used for clock-in. Care attendance still reads House's own
  // geofence fields. This is for the directory / future generalised attendance.
  geofenceRadius Int?
  timezone       String? // null => inherit Agency.timezone
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agency       Agency @relation(fields: [agencyId], references: [id])
  houses       House[]
  primaryUsers User[] @relation("UserPrimaryLocation")

  // Office Attendance Foundation back-relations. Nothing references a Location
  // through any of these yet — they exist so a future Location-backed
  // attendance phase has the relations in place. Care attendance is unaffected.
  shifts             Shift[]
  clockEvents        ClockEvent[]
  attendanceMonitors AttendanceMonitor[]
  timesheets         Timesheet[]

  @@index([agencyId, active])
}

// Server-side staging for HR-created employees. Employment data is written here
// (never into client-controlled Clerk metadata) when the invitation is sent,
// and consumed by the organizationMembership webhook once the person accepts.
// `consumedAt` makes consumption idempotent under duplicate webhook delivery;
// the (agencyId, email) pair scopes it so another agency can never adopt it.
model PendingEmployee {
  id                String          @id @default(cuid())
  agencyId          String
  email             String // always stored lower-cased
  invitationId      String? // Clerk organization invitation id
  role              Role
  employeeNumber    String?
  departmentId      String?
  jobTitleId        String?
  primaryLocationId String?
  lineManagerId     String?
  contractedHours   Float?
  workPatternType   WorkPatternType @default(ROTA)
  employmentType    EmploymentType?
  // ── HR Onboarding V1: personal + emergency-contact values staged here before
  //    the Clerk invite, applied to the User by the membership webhook. All
  //    nullable; a legacy invite without them still works. ──
  name                         String? // HR-entered legal/display name (see name-authority rule)
  phone                        String?
  address                      String?
  employmentStartDate          DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  invitedById       String?
  consumedAt        DateTime?
  // Set true when the membership webhook could not apply every staged field
  // (employee-number clash, or a department/job title/location/line manager that
  // was removed or deactivated between invite and acceptance). The User + auth
  // membership are still created; this flags that HR must finish the setup.
  needsReview       Boolean         @default(false)
  reviewNote        String?
  expiresAt         DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Staging data only — no history value, so it follows the agency lifecycle.
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, email])
  @@index([agencyId, consumedAt])
  @@index([agencyId, needsReview])
  @@index([expiresAt])
}
