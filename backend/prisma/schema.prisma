generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HR
  MANAGER
  TEAM_LEADER
  WORKER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ClockType {
  IN
  OUT
}

enum ClockMethod {
  AUTO
  MANUAL
}

enum GpsConfidence {
  HIGH
  MEDIUM
  LOW
  UNRELIABLE
}

enum LocationSource {
  GPS
  MANUAL
  OFFLINE_SYNC
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_REMOVED
  SHIFT_REMINDER
  MISSED_CLOCK_IN
  CLOCK_OUT_PROMPT
  GENERAL
}

enum TrainingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum DbsStatus {
  PENDING
  CLEAR
  FLAGGED
  EXPIRED
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftType {
  DAY
  WAKE_NIGHT
  SLEEP_IN
  EMERGENCY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  houses        House[]
  shifts        Shift[]
  clockEvents   ClockEvent[]
  timesheets    Timesheet[]
  notifications Notification[]
  trainings     Training[]
  dbsChecks     DbsCheck[]
  auditLogs     AuditLog[]
  leaveRequests LeaveRequest[]
}

model User {
  id             String   @id @default(cuid())
  agencyId       String   @default("default-agency")
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  status         UserStatus @default(ACTIVE)
  phone          String?
  bio            String?
  profilePicture String?
  address        String?
  fcmToken       String?
  deactivatedAt  DateTime?
  deactivatedById String?
  deactivationReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedHouses        House[]           @relation("ManagerHouses")
  workerHouses         HouseWorker[]
  teamLeaderHouses     HouseTeamLeader[]
  createdShifts        Shift[]           @relation("ShiftCreator")
  workerShifts         Shift[]           @relation("ShiftWorker")
  cancelledShifts      Shift[]           @relation("ShiftCanceller")
  clockEvents          ClockEvent[]
  timesheets           Timesheet[]       @relation("WorkerTimesheets")
  confirmedTimesheets  Timesheet[]       @relation("ConfirmedTimesheets")
  reviewedTimesheets   Timesheet[]       @relation("ReviewedTimesheets")
  notifications        Notification[]
  trainings            Training[]
  dbsCheck             DbsCheck?
  deactivatedBy        User?             @relation("UserDeactivations", fields: [deactivatedById], references: [id])
  deactivatedUsers     User[]            @relation("UserDeactivations")
  createdLeaveRequests LeaveRequest[]    @relation("LeaveRequestCreator")
  approvedLeaveRequests LeaveRequest[]   @relation("LeaveRequestReviewer")

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([status])
  @@index([deactivatedById])
}

model House {
  id             String   @id @default(cuid())
  agencyId       String   @default("default-agency")
  name           String
  address        String
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(50)
  autoConfirm    Boolean  @default(false)
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager     User?             @relation("ManagerHouses", fields: [managerId], references: [id])
  workers     HouseWorker[]
  teamLeaders HouseTeamLeader[]
  shifts      Shift[]
  clockEvents ClockEvent[]
  timesheets  Timesheet[]

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model HouseWorker {
  houseId  String
  workerId String

  house  House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  worker User  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([houseId, workerId])
}

model HouseTeamLeader {
  houseId      String
  teamLeaderId String

  house      House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  teamLeader User  @relation(fields: [teamLeaderId], references: [id], onDelete: Cascade)

  @@id([houseId, teamLeaderId])
}

model Shift {
  id          String   @id @default(cuid())
  agencyId    String   @default("default-agency")
  houseId     String
  workerId    String
  createdById String
  startTime   DateTime
  endTime     DateTime
  date        DateTime
  shiftType   ShiftType @default(DAY)
  status      ShiftStatus @default(SCHEDULED)
  cancelledAt DateTime?
  cancelledById String?
  cancellationReason String?
  createdAt   DateTime @default(now())

  house       House      @relation(fields: [houseId], references: [id])
  worker      User       @relation("ShiftWorker", fields: [workerId], references: [id])
  createdBy   User       @relation("ShiftCreator", fields: [createdById], references: [id])
  cancelledBy User?      @relation("ShiftCanceller", fields: [cancelledById], references: [id])
  clockEvents ClockEvent[]
  timesheet   Timesheet?
  agency      Agency     @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([shiftType])
  @@index([agencyId, startTime, endTime])
  @@index([workerId, startTime, endTime])
}

model ClockEvent {
  id        String      @id @default(cuid())
  agencyId  String      @default("default-agency")
  workerId  String
  houseId   String
  shiftId   String
  type      ClockType
  method    ClockMethod
  timestamp DateTime    @default(now())
  accuracy  Float?
  gpsConfidence GpsConfidence?
  locationSource LocationSource?

  worker User  @relation(fields: [workerId], references: [id])
  house  House @relation(fields: [houseId], references: [id])
  shift  Shift @relation(fields: [shiftId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  agencyId   String   @default("default-agency")
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  agency     Agency   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Timesheet {
  id            String    @id @default(cuid())
  agencyId      String    @default("default-agency")
  workerId      String
  houseId       String
  shiftId       String    @unique
  clockInAt     DateTime?
  clockOutAt    DateTime?
  totalHours    Float?
  status        TimesheetStatus @default(PENDING)
  rejectionReason String?
  confirmedById String?
  confirmedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  autoConfirmed Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  worker      User   @relation("WorkerTimesheets", fields: [workerId], references: [id])
  house       House  @relation(fields: [houseId], references: [id])
  shift       Shift  @relation(fields: [shiftId], references: [id])
  confirmedBy User?  @relation("ConfirmedTimesheets", fields: [confirmedById], references: [id])
  reviewedBy  User?  @relation("ReviewedTimesheets", fields: [reviewedById], references: [id])
  agency      Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model Notification {
  id        String           @id @default(cuid())
  agencyId  String           @default("default-agency")
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model Training {
  id          String         @id @default(cuid())
  agencyId    String         @default("default-agency")
  userId      String
  title       String
  description String?
  status      TrainingStatus @default(PENDING)
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model DbsCheck {
  id          String    @id @default(cuid())
  agencyId    String    @default("default-agency")
  userId      String    @unique
  status      DbsStatus @default(PENDING)
  reference   String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model LeaveRequest {
  id              String              @id @default(cuid())
  agencyId        String              @default("default-agency")
  workerId        String
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveRequestStatus  @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  worker      User   @relation("LeaveRequestCreator", fields: [workerId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])
  agency      Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([workerId])
  @@index([status])
  @@index([startDate, endDate])
}
