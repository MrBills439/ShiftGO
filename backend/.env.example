# ─── Sign-in (Better Auth) ───────────────────────────────────────────────
# Signs session cookies. 32+ random characters (openssl rand -base64 32).
# Different in every environment; changing it signs everyone out.
BETTER_AUTH_SECRET=replace_with_32_plus_random_characters
# Public URL of THIS API (auth routes live under /auth).
BETTER_AUTH_URL=http://localhost:4000
# Public URL of the web app — used for invitation links.
WEB_APP_URL=http://localhost:3000
# Shared with the web app (same value there). Lets the web server pass on each
# browser's real IP so sign-in limits count per person. 32+ random characters.
WEB_PROXY_SECRET=replace_with_32_plus_random_characters
# Load balancers / reverse proxies in front of this API (default 1). Used to
# read the real client IP from X-Forwarded-For safely. 0 if exposed directly.
# TRUST_PROXY_HOPS=1
# HR and managers must use an authenticator app. Leave true outside tests.
# REQUIRE_2FA_FOR_ADMINS=true
# ─── Email (Resend) — invitations and password-reset codes ───────────────
# Without a key, development logs emails to the console; production refuses
# to send (invitations fail with an error instead of silently vanishing).
RESEND_API_KEY=
EMAIL_FROM="ShiftGO <no-reply@yourshiftgodomain.com>"
DATABASE_URL=postgresql://shiftgo:shiftgo_pass@localhost:5432/shiftgo
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the web app's URL(s)). Required in production.
# Not needed for the mobile app — CORS only applies to browser requests.
# e.g. CORS_ORIGINS=https://app.yourshiftgodomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"
# Required in production by default. Set false only if push is intentionally disabled.
FIREBASE_REQUIRED=true
GEOFENCE_DEFAULT_RADIUS=50
# Base directory for persistent uploads (avatars, Right-to-Work documents).
# Leave unset locally — it defaults to backend/uploads.
# In production point it at the mounted persistent volume, e.g.:
# UPLOAD_DIR=/app/uploads
# Rate limits (per 15 minutes). API_RATE_LIMIT_MAX is per signed-in user;
# API_IP_RATE_LIMIT_MAX is a ceiling per IP address — keep it high, because a
# whole care home's staff usually share one IP.
# API_RATE_LIMIT_MAX=300
# API_IP_RATE_LIMIT_MAX=5000
# Background jobs (missed clock-in alerts, auto clock-out, fixed-pattern shifts).
# Each tick runs on ONE instance cluster-wide (Postgres advisory lock), so it is
# safe to run several replicas. Set false on an instance to stop it scheduling.
# RUN_SCHEDULER=true
# Right-to-Work document storage: local (default) or s3. See docs/DOCUMENT_STORAGE.md.
# RTW_STORAGE_DRIVER=s3
# S3_BUCKET=shiftgo-rtw-prod
# S3_REGION=eu-west-2
# S3_ENDPOINT=            # e.g. https://<account>.r2.cloudflarestorage.com; unset for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SSE=AES256           # aws:kms (+ S3_SSE_KMS_KEY_ID) | none
# Error monitoring (optional). Reports carry no request bodies, headers or
# personal details — see src/lib/monitoring.js.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Data retention (daily 03:15 UTC). REPORT-ONLY until RETENTION_ENABLED=true:
# it logs what it would delete. Deletion is permanent.
# RETENTION_ENABLED=false
# GPS_RETENTION_DAYS=90     # clear exact clock-in/out coordinates (outcome kept)
# RTW_RETENTION_DAYS=730    # delete RTW records 2 years after a person leaves
