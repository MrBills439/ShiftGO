CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret
DATABASE_URL=postgresql://shiftgo:shiftgo_pass@localhost:5432/shiftgo
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the web app's URL(s)). Required in production.
# Not needed for the mobile app — CORS only applies to browser requests.
# e.g. CORS_ORIGINS=https://app.yourshiftgodomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"
# Required in production by default. Set false only if push is intentionally disabled.
FIREBASE_REQUIRED=true
GEOFENCE_DEFAULT_RADIUS=50
