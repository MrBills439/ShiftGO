# Copy to .env.test. Loaded by jest.setup.js before any app code so `npm test`
# runs against a throwaway database instead of your dev data.
#
# Only override what must differ for tests — everything else still comes from .env.

# Use a database name that is clearly NOT your development one.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/shiftgo_test

NODE_ENV=test
