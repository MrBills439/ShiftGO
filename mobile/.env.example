# ShiftGO Mobile — LOCAL DEVELOPMENT environment only.
#
# Copy to `.env`. These values are read by `expo start` and inlined into the dev
# bundle. `.env` is git-ignored and is NOT uploaded to EAS cloud builds.
#
# EAS preview / production builds get their values from:
#   - mobile/eas.json  ->  build.<profile>.env            (EXPO_PUBLIC_API_URL)
#   - EAS Environment Variables (per environment)         (EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
# A release build with EXPO_PUBLIC_API_URL missing/not-https throws on startup —
# it can never silently fall back to localhost. See services/api.ts.

# ─── Clerk (publishable key — safe to embed in the client) ───────────────────
# Get it from the Clerk dashboard -> API keys -> "Publishable key".
# Use the pk_test_ key locally; production uses a pk_live_ key set in EAS.
# NEVER put the Clerk SECRET key (sk_...) in the mobile app — backend only.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ─── API backend URL (local dev) ────────────────────────────────────────────
# iOS simulator / web:            http://localhost:4000
# Android emulator:               http://10.0.2.2:4000
# Physical device on same Wi-Fi:  http://<your-machine-LAN-IP>:4000
#   (in dev the app also auto-derives the LAN host from the Metro server, so you
#    usually don't need to set this for a physical device)
# Production backend (do NOT put this in .env — it lives in eas.json):
#   https://shiftgo-production-4eac.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── Crash reporting (optional) ─────────────────────────────────────────────
# Set a Sentry DSN + `npx expo install @sentry/react-native` to enable.
# Without it, errors log to the console only. See lib/monitoring.ts.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# ─── Push notifications / Firebase ─────────────────────────────────────────
# Mobile clients register the native device push token with PATCH /users/me/fcm-token.
# Android builds require mobile/google-services.json; iOS builds require
# mobile/GoogleService-Info.plist. Never commit backend service-account keys.
