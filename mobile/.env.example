# ShiftGO Mobile — Environment Configuration

# ─── API Backend URL ──────────────────────────────────────────────────────────
# Development (Expo simulator): Use localhost
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Development (Physical device on same WiFi):
# 1. Find your machine IP: `ipconfig getifaddr en0` (Mac) or `ipconfig` (Windows)
# 2. Replace xxx.xxx.xxx.xxx with your IP:
# EXPO_PUBLIC_API_URL=http://xxx.xxx.xxx.xxx:4000

# Staging:
# EXPO_PUBLIC_API_URL=https://staging-api.shiftgo.com

# Production:
# EXPO_PUBLIC_API_URL=https://api.shiftgo.com

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# ─── Push Notifications / Firebase ───────────────────────────────────────────
# Mobile clients register the native device push token with:
#   PATCH /users/me/fcm-token
#
# Android production/dev builds require Firebase Android config:
#   mobile/google-services.json
#
# iOS production/dev builds require Firebase iOS config:
#   mobile/GoogleService-Info.plist
#
# Do not commit real Firebase config files unless your deployment policy allows
# app identifiers in source control. Never commit backend service-account keys.
