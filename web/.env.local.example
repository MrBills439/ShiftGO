# Where Next.js forwards /api/* (the ShiftGO backend). The browser only ever
# talks to this web app's own origin, so the session cookie stays first-party.
API_PROXY_TARGET=http://localhost:4000

# Same value as the backend's WEB_PROXY_SECRET. Lets the backend count sign-in
# attempts per browser instead of per web server.
WEB_PROXY_SECRET=
# Load balancers in front of this web app (default 1).
# TRUSTED_PROXY_HOPS=1
